# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# The URL and publishable key are needed in the browser as well as on the
# server, so they carry the VITE_ prefix that makes Vite inline them into the
# client bundle. Both are safe to expose: the publishable key grants nothing on
# its own, because every table is behind RLS.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Server-only. This key bypasses RLS entirely, so it must never gain a VITE_
# prefix — that would ship full database access to every visitor. It is used
# only for operations that legitimately run outside a user's authority, such as
# looking up an invitation by token before the invitee has an account.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Values above are the Supabase CLI's fixed local-development defaults and are
# identical on every machine. Real credentials belong in .env, which is ignored.
